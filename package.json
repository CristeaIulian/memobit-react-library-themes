{
  "name": "@memobit/themes",
  "version": "2.0.0",
  "description": "Themes for the Memobit apps: hand-made themes written as design choices, with every component value derived from them, plus the 49 classic themes, each published as its own stylesheet.",
  "keywords": [
    "css",
    "themes",
    "theming",
    "design-tokens",
    "dark-mode",
    "scss",
    "memobit"
  ],
  "author": "Iulian Cristea <iulianx@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://react.memobit.ro/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristeaIulian/memobit-react-library-themes.git"
  },
  "bugs": {
    "url": "https://github.com/CristeaIulian/memobit-react-library-themes/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./authored.css": "./dist/authored.css",
    "./authored/*.css": "./dist/authored/*.css",
    "./themes.css": "./dist/themes.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./src/theming/*.scss": "./src/theming/*.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/theming"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:themes": "node scripts/build-themes.mjs",
    "build:authored": "node scripts/build-authored.ts",
    "port:classic": "node scripts/port-classic.ts",
    "preview:concepts": "node scripts/preview-concepts.ts",
    "build": "npm run clean && npm run build:themes && npm run build:authored && vite build && npm pack",
    "release": "npm run build && npm publish",
    "prepublishOnly": "npm run clean && npm run build:themes && npm run build:authored && vite build",
    "typecheck": "tsc && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,css,scss}\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "25.8.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "sass": "1.99.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.3",
    "vite-plugin-dts": "5.0.0"
  }
}
